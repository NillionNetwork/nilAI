# NilAI Development Environment Variables
# Copy to .env and customize as needed

# --- General ---
ENVIRONMENT=mainnet
RUST_LOG=nilai_api=info,tower_http=info

# --- PostgreSQL ---
POSTGRES_USER=nilai
POSTGRES_PASSWORD=nilai_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nilai

# --- Redis ---
REDIS_URL=redis://redis:6379
DISCOVERY_URL=redis://redis:6379

# --- Auth ---
# AUTH_STRATEGY=api_key
# ADMIN_TOKEN=
# DOCS_TOKEN=Nillion2025

# --- Web Search (Brave) ---
# BRAVE_SEARCH_API=your-api-key-here

# --- Hugging Face (for vLLM) ---
# HF_TOKEN=your-hf-token-here
